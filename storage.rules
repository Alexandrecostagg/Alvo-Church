rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(orgId) {
      return /databases/(default)/documents/organizations/$(orgId)/users/$(request.auth.uid);
    }

    function tenantUser(orgId) {
      return firestore.get(userDocPath(orgId));
    }

    function isTenantMember(orgId) {
      return signedIn()
        && firestore.exists(userDocPath(orgId))
        && tenantUser(orgId).data.organizationId == orgId
        && tenantUser(orgId).data.isActive == true
        && firestore.get(/databases/(default)/documents/organizations/$(orgId)).data.status == "active";
    }

    function isTenantAdmin(orgId) {
      return isTenantMember(orgId)
        && tenantUser(orgId).data.roles.hasAny([
          "super_admin",
          "church_admin",
          "pastor",
          "secretary"
        ]);
    }

    // Backend-only Kids media; no Firebase download tokens are issued.
    match /finance-private/{allPaths=**} {
      allow read, write: if false;
    }

    match /kids-private/{allPaths=**} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/branding/{assetKind}/{fileName} {
      allow read: if isTenantMember(orgId);
      allow create, update: if isTenantAdmin(orgId)
        && assetKind in ["logoLight", "logoDark", "icon", "favicon"]
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ["image/png", "image/jpeg", "image/webp"];
      allow delete: if isTenantAdmin(orgId);
    }

    match /organizations/{orgId}/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
