rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid);
    }

    function tenantUserExists(orgId) {
      return exists(userDocPath(orgId));
    }

    function tenantUserData(orgId) {
      return get(userDocPath(orgId)).data;
    }

    function hasTenantAccount(orgId) {
      return signedIn()
        && tenantUserExists(orgId)
        && tenantUserData(orgId).organizationId == orgId;
    }

    function hasActiveTenantAccount(orgId) {
      return hasTenantAccount(orgId)
        && tenantUserData(orgId).isActive == true;
    }

    function isTenantMember(orgId) {
      return hasActiveTenantAccount(orgId)
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && (!("status" in get(/databases/$(database)/documents/organizations/$(orgId)).data)
          || get(/databases/$(database)/documents/organizations/$(orgId)).data.status == "active");
    }

    function isTenantAdmin(orgId) {
      return isTenantMember(orgId)
        && tenantUserData(orgId).roles.hasAny([
          "super_admin",
          "church_admin",
          "pastor",
          "secretary"
        ]);
    }

    // Administração de acessos é mais restrita que operação do tenant.
    // Pastores e secretaria podem operar módulos compatíveis com o cargo,
    // mas não concedem nem removem permissões de outras pessoas.
    function canManageTenantUsers(orgId) {
      return isTenantMember(orgId)
        && tenantUserData(orgId).roles.hasAny([
          "super_admin",
          "church_admin"
        ]);
    }

    function featuresDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/settings/features;
    }

    // Ausência de configuração mantém compatibilidade com organizações
    // antigas. Somente enabled == false, definido pela administração da
    // plataforma, interrompe leituras e gravações diretas do módulo.
    function moduleEnabled(orgId, moduleKey) {
      let path = featuresDocPath(orgId);
      return !exists(path)
        || !("modules" in get(path).data)
        || !(moduleKey in get(path).data.modules)
        || !("enabled" in get(path).data.modules[moduleKey])
        || get(path).data.modules[moduleKey].enabled != false;
    }

    function operationalModuleEnabled(orgId, collection) {
      return (![
          "groups", "groupBanners"
        ].hasAny([collection]) || moduleEnabled(orgId, "groups"))
        && (![
          "scheduleSwapRequests", "serviceAssignments", "serviceTeams",
          "worshipSetlists", "worshipSongs"
        ].hasAny([collection]) || moduleEnabled(orgId, "volunteers"))
        && (![
          "memberTribeProfiles", "tribeAssessments", "tribeBehaviorSignals",
          "tribeReviewRequests", "tribes"
        ].hasAny([collection]) || moduleEnabled(orgId, "tribes"))
        && (![
          "badges", "journeyProfiles"
        ].hasAny([collection]) || moduleEnabled(orgId, "journeys"))
        && (collection != "financeReports" || moduleEnabled(orgId, "finance"))
        && (collection != "visitorJourneys" || moduleEnabled(orgId, "visitors"))
        && (collection != "weeklyThemes" || moduleEnabled(orgId, "communication"));
    }

    // Coleções operacionais conhecidas. O Firestore não tem "deny" que
    // sobreponha outro allow: por isso o catch-all abaixo só pode liberar uma
    // lista fechada. Coleção nova exige regra e revisão de segurança próprias.
    function isOperationalCollection(collection) {
      return [
        "badges", "churchAttendance",
        "courses", "events", "families",
        "financeReports", "followUpTasks", "groupBanners", "groups",
        "journeyProfiles",
        "memberTribeProfiles", "partners", "partnerBenefits",
        "scheduleSwapRequests", "serviceAssignments", "serviceTeams",
        "tribeAssessments", "tribeBehaviorSignals", "tribeReviewRequests",
        "tribes", "visitorJourneys", "wellBeingResources", "weeklyThemes",
        "worshipSetlists", "worshipSongs"
      ].hasAny([collection]);
    }

    // Check-ins de crianças carregam dados de menor (foto, alergias e
    // restrições). Fora da equipe Kids, o responsável só pode acessar os
    // registros em que está listado como pai/mãe ou pessoa autorizada.
    function isKidsGuardianFor(orgId, checkIn) {
      return isTenantMember(orgId)
        && (
          checkIn.parentId == request.auth.uid
          || checkIn.authorizedPickUpIds.hasAny([request.auth.uid])
        );
    }

    function orgDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    // The signed-in user who provisioned the organization (recorded at creation).
    function isOrgOwner(orgId) {
      return signedIn()
        && exists(orgDocPath(orgId))
        && get(orgDocPath(orgId)).data.ownerUid == request.auth.uid;
    }

    // Platform admin: owner/operator of the Esdras platform itself, distinct
    // from "super_admin" (which is only a top role *within one tenant*).
    // Bootstrapped by hand into platformAdmins/{uid}; read-only across every
    // organization — never grants write access to tenant data.
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    match /platformAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Loja de Capacitação: catálogo GLOBAL de trilhas autoradas pela Esdras.
    // Qualquer membro autenticado navega/lê (a loja mostra só publicadas via
    // query where isPublished==true; membros com entitlement também leem
    // trilhas despublicadas que já compraram). Escrita só do platform admin.
    match /platformPrograms/{programId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow write: if isPlatformAdmin();

      match /{sub}/{subDoc} { // modules + lessons
        allow read: if signedIn();
        allow write: if isPlatformAdmin();
      }
    }

    // ── Limites por plano ──────────────────────────────────────────────────
    // Espelha packages/firebase/src/plans.ts (PLAN_LIMITS). Rules não
    // importam TS, então os números vivem duplicados aqui — se mudar um
    // lado, mudar o outro.
    function subscriptionDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/settings/subscription;
    }

    function resolvedPlan(orgId) {
      let sub = exists(subscriptionDocPath(orgId)) ? get(subscriptionDocPath(orgId)).data : {};
      return "plan" in sub
        ? sub.plan
        : (
          !("planTier" in sub) ? "free" :
          sub.planTier == "growth" ? "comunidade" :
          sub.planTier == "advanced" ? "pastoral" :
          sub.planTier == "enterprise" ? "rede" :
          "free"
        );
    }

    function branchOrgLimit(orgId) {
      let plan = resolvedPlan(orgId);
      return plan == "rede" ? 50
        : plan == "enterprise" ? 999
        : 0; // free / comunidade / pastoral: sem multi-tenant
    }

    function orgCounter(orgId, field) {
      let org = get(orgDocPath(orgId)).data;
      return field in org ? org[field] : 0;
    }

    function withinBranchOrgLimit(orgId) {
      return orgCounter(orgId, "affiliateCount") < branchOrgLimit(orgId);
    }

    // Diretório mínimo de instituições. Visitantes públicos só consultam um
    // slug conhecido; usuários autenticados podem listar nome, slug e orgId
    // para escolher sua instituição no app. A criação abaixo restringe os
    // documentos exatamente a esses três dados públicos.
    match /org_slugs/{slug} {
      allow get: if true;
      allow list: if signedIn();
      // Only the owner of the organization being pointed to may claim a
      // slug, and only once (Firestore rejects create if the doc already
      // exists) — prevents hijacking another church's public form.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["organizationId", "displayName"])
        && request.resource.data.organizationId is string
        && isOrgOwner(request.resource.data.organizationId);
      allow update, delete: if false;
    }

    // Organization root document: creatable once by its owner, managed by admins.
    match /organizations/{orgId} {
      allow get: if hasTenantAccount(orgId) || isOrgOwner(orgId) || isPlatformAdmin();
      // Listing the whole collection (e.g. fetchAllOrganizations) is only
      // for the platform admin's cross-tenant dashboard / org switcher.
      allow list: if isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      // Plano, abrangência e contadores são dados de cobrança/provisionamento.
      // Um administrador do tenant pode atualizar os dados cadastrais, mas
      // jamais trocar organização solo por rede, liberar uma modalidade ou
      // manipular os contadores usados para aplicar limites do plano.
      allow update: if isTenantAdmin(orgId)
          && (
            !("ownerUid" in resource.data)
            || request.resource.data.ownerUid == resource.data.ownerUid
          )
          && (
            !("organizationTier" in resource.data)
              ? !("organizationTier" in request.resource.data)
              : request.resource.data.organizationTier == resource.data.organizationTier
          )
          && (
            !("organizationType" in resource.data)
              ? !("organizationType" in request.resource.data)
              : request.resource.data.organizationType == resource.data.organizationType
          )
          && (
            !("memberCount" in resource.data)
              ? !("memberCount" in request.resource.data)
              : request.resource.data.memberCount == resource.data.memberCount
          )
          && (
            !("affiliateCount" in resource.data)
              ? !("affiliateCount" in request.resource.data)
              : request.resource.data.affiliateCount == resource.data.affiliateCount
          )
          && (
            !("status" in resource.data)
              ? !("status" in request.resource.data)
              : request.resource.data.status == resource.data.status
          );
      allow delete: if false;
    }

    match /organizations/{orgId}/users/{userId} {
      // Only the org owner may bootstrap their own admin access;
      // everyone else must be provisioned by an existing admin.
      allow create: if signedIn()
        && request.resource.data.organizationId == orgId
        && (!("personId" in request.resource.data) || request.resource.data.personId == null)
        && (
          (request.auth.uid == userId && isOrgOwner(orgId))
          || canManageTenantUsers(orgId)
        );

      allow read: if signedIn() && (request.auth.uid == userId || canManageTenantUsers(orgId));

      // Users may edit their own profile but never their roles,
      // active flag or tenant binding.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(["personId"])
        && (canManageTenantUsers(orgId) || (
          signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["roles", "isActive", "organizationId"])
        ));

      allow delete: if canManageTenantUsers(orgId)
        && !exists(/databases/$(database)/documents/organizations/$(orgId)/memberAccountLinks/$(userId));
    }

    // Only the authenticated backend establishes a verified one-to-one link.
    // Old users.personId values alone are not proof of identity.
    function ownsPerson(orgId, personId) {
      let linkPath = /databases/$(database)/documents/organizations/$(orgId)/memberAccountLinks/$(request.auth.uid);
      let claimPath = /databases/$(database)/documents/organizations/$(orgId)/memberAccountClaims/$(personId);
      return isTenantMember(orgId) && exists(linkPath) && exists(claimPath)
        && get(linkPath).data.personId == personId
        && get(linkPath).data.organizationId == orgId
        && get(linkPath).data.userId == request.auth.uid
        && get(linkPath).data.verifiedBy is string
        && get(claimPath).data.userId == request.auth.uid
        && get(claimPath).data.organizationId == orgId
        && get(claimPath).data.personId == personId
        && tenantUserData(orgId).personId == personId;
    }
    match /organizations/{orgId}/memberAccountLinks/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/memberAccountClaims/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/memberAccountAudit/{id} {
      allow read: if canManageTenantUsers(orgId);
      allow write: if false;
    }
    match /organizations/{orgId}/memberBenefitValidations/{id} {
      allow read: if isTenantAdmin(orgId) || ownsPerson(orgId, resource.data.personId);
      allow write: if isTenantAdmin(orgId);
    }

    // Assinatura e módulos são definidos no provisionamento e no processo de
    // cobrança da Esdras. Um administrador da igreja pode ler, mas não pode
    // liberar recursos nem alterar o plano por chamada direta ao Firestore.
    match /organizations/{orgId}/settings/subscription {
      allow read: if hasTenantAccount(orgId) || isPlatformAdmin();
      // A primeira assinatura vem exclusivamente do cadastro público e deve
      // iniciar no plano gratuito. Alterações posteriores passam pelo backend
      // de cobrança (Admin SDK) ou por um administrador da plataforma.
      allow create: if isPlatformAdmin()
        || (isOrgOwner(orgId)
          && request.resource.data.organizationId == orgId
          && request.resource.data.plan == "free");
      // O checkout pode apenas vincular os IDs retornados pelo gateway; nunca
      // troca plano, status ou limites diretamente no cliente. A gestão Esdras
      // também passa pela API auditada, que usa credencial de servidor.
      allow update: if isTenantAdmin(orgId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["asaasCustomerId", "asaasSubscriptionId"]);
      allow delete: if false;
    }

    match /organizations/{orgId}/settings/features {
      allow read: if hasTenantAccount(orgId) || isPlatformAdmin();
      // O documento inicial é criado junto da organização. Depois disso,
      // somente a API auditada da administração Esdras pode ajustar a
      // disponibilidade técnica depois do provisionamento inicial.
      allow create: if isPlatformAdmin() || isOrgOwner(orgId);
      allow update, delete: if false;
    }

    match /organizations/{orgId}/settings/{documentId} {
      allow read: if isTenantMember(orgId) || isPlatformAdmin();
      // Mantém configurações operacionais permitidas (marca, PIX, Kids etc.)
      // nas mãos da igreja, sem reabrir subscription/features por este match.
      allow write: if documentId != "subscription"
        && documentId != "features"
        && (isTenantAdmin(orgId) || isPlatformAdmin());
    }

    // Permite montar apenas a identidade visual da tela de bloqueio quando a
    // instituição está inativa/suspensa. Demais configurações continuam fechadas.
    match /organizations/{orgId}/settings/branding {
      allow read: if hasTenantAccount(orgId) || isPlatformAdmin();
    }

    // Contadores de IA são escritos somente pelo backend com service account,
    // dentro de transação. Permitir escrita pelo cliente permitiria burlar a
    // cota ou corromper o consumo da organização.
    match /organizations/{orgId}/aiRateLimits/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/aiAudit/{id} {
      allow read: if isTenantAdmin(orgId);
      allow write: if false;
    }
    match /organizations/{orgId}/aiUsage/{documentId} {
      allow read: if isTenantMember(orgId) || isPlatformAdmin();
      allow write: if false;
    }

    // Financial writes are server transactions; members read only their own declarations.
    match /organizations/{orgId}/contributions/{contributionId} {
      allow read: if moduleEnabled(orgId, "giving") && (isTenantAdmin(orgId)
        || (isTenantMember(orgId) && resource.data.userId == request.auth.uid));

      allow write: if false;
    }

    // Promoções do marketplace (nível flat da org): membro lê (feed/notificação
    // in-app no app), só admin publica/edita.
    match /organizations/{orgId}/marketplacePromotions/{promotionId} {
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "marketplace");
      allow write: if isTenantAdmin(orgId) && moduleEnabled(orgId, "marketplace");
    }

    // Comunicação (histórico de envios + templates): só liderança (admin) —
    // conteúdo de comunicados é sensível. Excluído dos catch-alls de leitura.
    match /organizations/{orgId}/communicationLog/{entryId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "communication");
      allow write: if false;
    }
    match /organizations/{orgId}/communicationTemplates/{templateId} {
      allow read, write: if isTenantAdmin(orgId) && moduleEnabled(orgId, "communication");
    }
    match /organizations/{orgId}/communicationCampaigns/{entryId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "communication");
      allow write: if false;
    }
    match /organizations/{orgId}/communicationAudit/{entryId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "communication");
      allow write: if false;
    }

    // Receipt metadata and legacy media are available only through the private API.
    match /organizations/{orgId}/contributionReceipts/{receiptId} {
      allow read, write: if false;
    }

    // Mídia — histórico de banners gerados (thumbnail + inputs para reabrir).
    // Qualquer membro lê e cria o próprio histórico; não pode editar registros
    // de outro membro nem trocar autor/organização. Administração mantém a
    // moderação completa, inclusive exclusão.
    match /organizations/{orgId}/bannerHistory/{bannerId} {
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "ai");
      allow create: if isTenantMember(orgId) && moduleEnabled(orgId, "ai")
        && request.resource.data.organizationId == orgId
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update: if moduleEnabled(orgId, "ai") && (isTenantAdmin(orgId)
        || (
          isTenantMember(orgId)
          && resource.data.createdByUserId == request.auth.uid
          && request.resource.data.createdByUserId == resource.data.createdByUserId
          && request.resource.data.organizationId == resource.data.organizationId
        ));
      allow delete: if isTenantAdmin(orgId) && moduleEnabled(orgId, "ai");
    }

    // Visitor intake público entra exclusivamente pelo backend (com limite de
    // IP e honeypot). Não permitir create direto impede contornar as proteções
    // da API por REST/SDK do Firestore.
    match /organizations/{orgId}/visitorIntakes/{intakeId} {
      // Recepção autenticada continua podendo registrar atendimento interno;
      // o visitante público só entra pela API server-side.
      allow create: if isTenantAdmin(orgId) && moduleEnabled(orgId, "visitors");
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "visitors");
      allow update, delete: if isTenantAdmin(orgId) && moduleEnabled(orgId, "visitors");
    }

    // Campanhas de oferta (metas de arrecadação): gestão só do time (admin);
    // membro lista; UMA campanha pode ser lida publicamente (get) pra o link
    // público /p/{slug}/give?campanha={id} mostrar título/meta/progresso.
    match /organizations/{orgId}/givingCampaigns/{campaignId} {
      allow get: if moduleEnabled(orgId, "giving");
      allow list: if isTenantMember(orgId) && moduleEnabled(orgId, "giving");
      allow create: if isTenantAdmin(orgId) && moduleEnabled(orgId, "giving") && request.resource.data.organizationId == orgId && request.resource.data.raisedAmount == 0;
      allow update: if isTenantAdmin(orgId) && moduleEnabled(orgId, "giving") && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["organizationId", "raisedAmount"]);
      allow delete: if isTenantAdmin(orgId) && moduleEnabled(orgId, "giving") && resource.data.raisedAmount == 0;
    }

    // Public declarations are mediated by a scoped, expiring capability.
    match /organizations/{orgId}/givingReceipts/{receiptId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "giving");
      allow write: if false;
    }

    // Donor contacts are private; public writes cannot bypass backend quotas.
    match /organizations/{orgId}/givingIntents/{intentId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "giving");
      allow write: if false;
    }

    // Ledger financeiro (lançamentos de entrada/saída/missões): dado sensível —
    // só a liderança administrativa lê e escreve.
    match /organizations/{orgId}/financialTransactions/{transactionId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "finance");
      allow write: if false;
    }

    match /organizations/{orgId}/billingOrders/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/billingEvents/{id} {
      allow read: if isTenantAdmin(orgId);
      allow write: if false;
    }
    match /organizations/{orgId}/financeAudit/{id} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "finance");
      allow write: if false;
    }
    match /organizations/{orgId}/financeReferences/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/givingLimits/{id} {
      allow read, write: if false;
    }

    // Prayer requests: any signed-in tenant member can submit one (from the
    // app or reception). Pastoral staff can read/triage/resolve all of them;
    // regular members can only read ones the author opted to make public
    // (the community prayer wall), and may only bump the prayer counter.
    match /organizations/{orgId}/prayerRequests/{requestId} {
      allow create: if isTenantMember(orgId)
        && request.resource.data.organizationId == orgId
        && request.resource.data.status == "open"
        && request.resource.data.isPublic is bool
        && request.resource.data.prayerCount == 0
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.personName is string
        && request.resource.data.personName.size() <= 160;

      allow read: if isTenantAdmin(orgId)
        || (isTenantMember(orgId) && resource.data.isPublic == true);

      allow update: if isTenantAdmin(orgId)
        || (
          isTenantMember(orgId)
          && resource.data.isPublic == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["prayerCount"])
          && request.resource.data.prayerCount == resource.data.prayerCount + 1
        );

      allow delete: if isTenantAdmin(orgId);
    }

    // Cadastro de pessoas: limitado pelo plano da organização (Gratuito 50,
    // Comunidade 300, Pastoral/Rede sem limite). O contador memberCount em
    // organizations/{orgId} é mantido pela própria app (savePersonProfile).
    match /organizations/{orgId}/people/{personId} {
      allow get: if isTenantAdmin(orgId) || ownsPerson(orgId, personId);
      allow list: if isTenantAdmin(orgId);
      // Every creation path uses the central transaction and the real count.
      allow create: if false;
      allow update: if isTenantAdmin(orgId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["organizationId", "cpf", "memberCardCode", "partnerBenefitsEnabled", "consentLgpdAt"]);
      allow delete: if isTenantAdmin(orgId);
    }

    match /organizations/{orgId}/publicIntakeLimits/{id} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/memberRegistrations/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/memberCpfClaims/{id} {
      allow read, write: if false;
    }

    // Histórico de tribo do membro: auditoria de classificações (IA) e ajustes
    // manuais. Membro do tenant lê; só admin grava (registro é imutável — sem
    // update/delete pelo cliente).
    match /organizations/{orgId}/people/{personId}/tribeHistory/{entryId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantAdmin(orgId);
      allow update, delete: if false;
    }

    // Conteúdo EAD é administrado pelo backend para validar publicação,
    // hierarquia módulo/aula e preservar progresso durante alterações.
    match /organizations/{orgId}/courses/{courseId} {
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "journeys");
      allow write: if false;

      match /{sub}/{subDoc} {
        allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "journeys") && (sub == "modules" || sub == "lessons");
        allow write: if false;
      }
    }
    match /organizations/{orgId}/courseManagementAttempts/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/courseManagementAudit/{id} {
      allow read: if isTenantAdmin(orgId);
      allow write: if false;
    }

    // O progresso EAD usa o vínculo privado conta↔pessoa e uma transação no
    // backend. O cliente não escolhe personId, badge nem percentual concluído.
    match /organizations/{orgId}/people/{personId}/courseProgress/{progressId} {
      allow read: if moduleEnabled(orgId, "journeys") && (isTenantAdmin(orgId) || ownsPerson(orgId, personId));
      allow write: if false;
    }
    match /organizations/{orgId}/people/{personId}/badges/{badgeId} {
      allow read: if moduleEnabled(orgId, "journeys") && (isTenantAdmin(orgId) || ownsPerson(orgId, personId));
      allow write: if false;
    }
    match /organizations/{orgId}/learningAttempts/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/learningAudit/{id} {
      allow read: if isTenantAdmin(orgId);
      allow write: if false;
    }

    // Igrejas filiais (plano Rede): até 50 filiais, só quem está no plano
    // Rede ou Enterprise pode ter alguma. O contador affiliateCount em
    // organizations/{orgId} é mantido por saveNetworkAffiliate.
    match /organizations/{orgId}/affiliates/{affiliateId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantAdmin(orgId) && withinBranchOrgLimit(orgId);
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Entitlements de trilhas compradas na Loja de Capacitação. Membros leem
    // (para saber o que a igreja já comprou); NINGUÉM escreve pelo cliente —
    // só o webhook de pagamento (service account, que ignora as rules). Sem
    // isso, um admin poderia se auto-conceder acesso gratuito.
    match /organizations/{orgId}/programEntitlements/{programId} {
      allow read: if isTenantMember(orgId);
      allow write: if false;
    }

    // Segurança Kids: check-in/out de crianças (dado sensível de menor).
    // A lista completa é exclusiva da equipe Kids. Responsáveis fazem query
    // restrita aos próprios filhos/pessoas autorizadas e só leem esses docs.
    match /organizations/{orgId}/kidsCheckIns/{checkInId} {
      allow get, list: if moduleEnabled(orgId, "children") && (isTenantAdmin(orgId) || isKidsGuardianFor(orgId, resource.data));
      // Entrada, vínculo e retirada são transações autenticadas no backend.
      allow write: if false;
    }

    match /organizations/{orgId}/kidsRoomLocks/{id} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/kidsChildPresence/{id} {
      allow read, write: if false;
    }

    match /organizations/{orgId}/kidsOperationSessions/{id} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "children");
      allow write: if false;
    }

    match /organizations/{orgId}/kidsCustodyAudit/{id} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "children");
      allow write: if false;
    }

    // Eventos e inscrições passam pelo backend: ele valida status, datas,
    // capacidade, pagamento e preserva inscrições ao cancelar um evento.
    match /organizations/{orgId}/events/{eventId} {
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "events");
      allow write: if false;
    }
    match /organizations/{orgId}/events/{eventId}/registrations/{regId} {
      allow read: if moduleEnabled(orgId, "events") && (isTenantAdmin(orgId)
        || (isTenantMember(orgId) && resource.data.responsiblePersonId == request.auth.uid));
      allow write: if false;
    }
    match /organizations/{orgId}/events/{eventId}/tickets/{ticketId} {
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "events");
      allow write: if isTenantAdmin(orgId) && moduleEnabled(orgId, "events");
    }
    match /organizations/{orgId}/events/{eventId}/checkIns/{checkInId} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "events");
      allow write: if false;
    }
    match /organizations/{orgId}/eventAttempts/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/eventAttendanceAudit/{id} {
      allow read: if isTenantAdmin(orgId);
      allow write: if false;
    }
    match /organizations/{orgId}/eventManagementAttempts/{id} {
      allow read, write: if false;
    }
    match /organizations/{orgId}/eventManagementAudit/{id} {
      allow read: if isTenantAdmin(orgId);
      allow write: if false;
    }

    // Personal wellbeing records are visible to their author and pastoral staff.
    match /organizations/{orgId}/leaderEmotionalPulse/{id} {
      allow read: if isTenantAdmin(orgId) || (isTenantMember(orgId) && resource.data.leaderId == request.auth.uid);
      allow create: if isTenantMember(orgId)
        && request.resource.data.organizationId == orgId
        && request.resource.data.leaderId == request.auth.uid
        && request.resource.data.energyLevel is number && request.resource.data.energyLevel >= 0 && request.resource.data.energyLevel <= 10
        && request.resource.data.stressLevel is number && request.resource.data.stressLevel >= 0 && request.resource.data.stressLevel <= 10;
      allow update, delete: if false;
    }
    match /organizations/{orgId}/emergencySOS/{id} {
      allow read: if isTenantAdmin(orgId) || (isTenantMember(orgId) && resource.data.leaderId == request.auth.uid);
      allow create: if isTenantMember(orgId) && request.resource.data.organizationId == orgId
        && request.resource.data.leaderId == request.auth.uid && request.resource.data.status == "active";
      allow update: if isTenantAdmin(orgId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["organizationId", "leaderId"]);
      allow delete: if false;
    }
    match /organizations/{orgId}/mentoringSessions/{id} {
      allow read: if isTenantAdmin(orgId) || (isTenantMember(orgId) && resource.data.leaderId == request.auth.uid);
      allow create: if isTenantAdmin(orgId) && request.resource.data.organizationId == orgId;
      allow update: if isTenantAdmin(orgId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["organizationId", "leaderId"]);
      allow delete: if isTenantAdmin(orgId);
    }
    match /organizations/{orgId}/communityStores/{id} {
      allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "marketplace") && (isTenantAdmin(orgId) || resource.data.status == "approved" || resource.data.ownerId == request.auth.uid);
      allow create: if isTenantMember(orgId) && moduleEnabled(orgId, "marketplace") && request.resource.data.organizationId == orgId
        && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == "pending"
        && !request.resource.data.keys().hasAny(["moderatedBy", "approvedAt", "rejectionReason", "suspensionReason"]);
      // Editing a published store by its owner sends it back for moderation.
      allow update: if isTenantMember(orgId) && moduleEnabled(orgId, "marketplace") && request.resource.data.organizationId == orgId
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "pending"
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["ownerId", "organizationId", "createdAt", "moderatedBy", "approvedAt", "rejectionReason", "suspensionReason"]);
      allow delete: if false;
      match /offers/{offerId} {
        allow read: if isTenantMember(orgId) && moduleEnabled(orgId, "marketplace") && (isTenantAdmin(orgId) || (get(/databases/$(database)/documents/organizations/$(orgId)/communityStores/$(id)).data.status == "approved" && resource.data.status == "active"));
        allow write: if isTenantAdmin(orgId) && moduleEnabled(orgId, "marketplace");
      }
    }
    match /organizations/{orgId}/communityStoreModerationLogs/{id} {
      allow read: if isTenantAdmin(orgId) && moduleEnabled(orgId, "marketplace");
      allow write: if false;
    }
    match /organizations/{orgId}/communityStoreModerationAttempts/{id} {
      allow read, write: if false;
    }

    // Coleções operacionais de primeiro nível. A lista fechada acima evita
    // que uma coleção nova herde acesso por acidente.
    match /organizations/{orgId}/{collection}/{documentId} {
      allow read: if isTenantMember(orgId) && isOperationalCollection(collection)
        && operationalModuleEnabled(orgId, collection)
        && collection != "events" && collection != "courses";
      allow write: if isTenantAdmin(orgId) && isOperationalCollection(collection)
        && operationalModuleEnabled(orgId, collection)
        && collection != "events" && collection != "courses";
    }

    // Subcoleções dos módulos operacionais da lista fechada. Coleções sensíveis
    // (people, users, contribuições, kids, assinatura) têm regras específicas
    // e não podem ser reabertas por este match via OR.
    match /organizations/{orgId}/{collection}/{documentId}/{document=**} {
      // Subcoleções de events têm políticas próprias acima porque inscrições
      // e presença contêm dados pessoais e transições financeiras.
      allow read: if isTenantMember(orgId) && isOperationalCollection(collection)
        && operationalModuleEnabled(orgId, collection)
        && collection != "events" && collection != "courses";
      allow write: if isTenantAdmin(orgId) && isOperationalCollection(collection)
        && operationalModuleEnabled(orgId, collection)
        && collection != "events" && collection != "courses";
    }
  }
}
