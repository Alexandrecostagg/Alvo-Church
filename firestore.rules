rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid);
    }

    function tenantUserExists(orgId) {
      return exists(userDocPath(orgId));
    }

    function tenantUserData(orgId) {
      return get(userDocPath(orgId)).data;
    }

    function isTenantMember(orgId) {
      return signedIn()
        && tenantUserExists(orgId)
        && tenantUserData(orgId).organizationId == orgId
        && tenantUserData(orgId).isActive == true;
    }

    function isTenantAdmin(orgId) {
      return isTenantMember(orgId)
        && tenantUserData(orgId).roles.hasAny([
          "super_admin",
          "church_admin",
          "pastor",
          "secretary"
        ]);
    }

    // Segurança Kids: quem pode operar o check-in/out (gravar kidsCheckIns).
    // Honra a config do admin (settings/kids.qrGeneratorRoles); se ausente,
    // cai para os admins do tenant. Boundary grosseiro no servidor — o app
    // ainda exige estar escalado na sala.
    function kidsSettingsPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/settings/kids;
    }
    function kidsQrRoles(orgId) {
      return exists(kidsSettingsPath(orgId)) && ("qrGeneratorRoles" in get(kidsSettingsPath(orgId)).data)
        ? get(kidsSettingsPath(orgId)).data.qrGeneratorRoles
        : [];
    }
    function canOperateKids(orgId) {
      return isTenantMember(orgId)
        && (isTenantAdmin(orgId) || tenantUserData(orgId).roles.hasAny(kidsQrRoles(orgId)));
    }

    function orgDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId);
    }

    // The signed-in user who provisioned the organization (recorded at creation).
    function isOrgOwner(orgId) {
      return signedIn()
        && exists(orgDocPath(orgId))
        && get(orgDocPath(orgId)).data.ownerUid == request.auth.uid;
    }

    // Platform admin: owner/operator of the Esdras platform itself, distinct
    // from "super_admin" (which is only a top role *within one tenant*).
    // Bootstrapped by hand into platformAdmins/{uid}; read-only across every
    // organization — never grants write access to tenant data.
    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    match /platformAdmins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Loja de Capacitação: catálogo GLOBAL de trilhas autoradas pela Esdras.
    // Qualquer membro autenticado navega/lê (a loja mostra só publicadas via
    // query where isPublished==true; membros com entitlement também leem
    // trilhas despublicadas que já compraram). Escrita só do platform admin.
    match /platformPrograms/{programId} {
      allow get: if signedIn();
      allow list: if signedIn();
      allow write: if isPlatformAdmin();

      match /{sub}/{subDoc} { // modules + lessons
        allow read: if signedIn();
        allow write: if isPlatformAdmin();
      }
    }

    // ── Limites por plano ──────────────────────────────────────────────────
    // Espelha packages/firebase/src/plans.ts (PLAN_LIMITS). Rules não
    // importam TS, então os números vivem duplicados aqui — se mudar um
    // lado, mudar o outro.
    function subscriptionDocPath(orgId) {
      return /databases/$(database)/documents/organizations/$(orgId)/settings/subscription;
    }

    function resolvedPlan(orgId) {
      let sub = exists(subscriptionDocPath(orgId)) ? get(subscriptionDocPath(orgId)).data : {};
      return "plan" in sub
        ? sub.plan
        : (
          !("planTier" in sub) ? "free" :
          sub.planTier == "growth" ? "comunidade" :
          sub.planTier == "advanced" ? "pastoral" :
          sub.planTier == "enterprise" ? "rede" :
          "free"
        );
    }

    function memberLimit(orgId) {
      let plan = resolvedPlan(orgId);
      return plan == "free" ? 50
        : plan == "comunidade" ? 300
        : 999999999; // pastoral / rede / enterprise: sem limite de membros
    }

    function branchOrgLimit(orgId) {
      let plan = resolvedPlan(orgId);
      return plan == "rede" ? 50
        : plan == "enterprise" ? 999
        : 0; // free / comunidade / pastoral: sem multi-tenant
    }

    function orgCounter(orgId, field) {
      let org = get(orgDocPath(orgId)).data;
      return field in org ? org[field] : 0;
    }

    function withinMemberLimit(orgId) {
      return orgCounter(orgId, "memberCount") < memberLimit(orgId);
    }

    function withinBranchOrgLimit(orgId) {
      return orgCounter(orgId, "affiliateCount") < branchOrgLimit(orgId);
    }

    // Slug lookup for public forms: single-doc get only (no listing),
    // exposes just the slug -> organizationId mapping.
    match /org_slugs/{slug} {
      allow get: if true;
      allow list: if false;
      // Only the owner of the organization being pointed to may claim a
      // slug, and only once (Firestore rejects create if the doc already
      // exists) — prevents hijacking another church's public form.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["organizationId", "displayName"])
        && request.resource.data.organizationId is string
        && isOrgOwner(request.resource.data.organizationId);
      allow update, delete: if false;
    }

    // Organization root document: creatable once by its owner, managed by admins.
    match /organizations/{orgId} {
      allow get: if isTenantMember(orgId) || isOrgOwner(orgId) || isPlatformAdmin();
      // Listing the whole collection (e.g. fetchAllOrganizations) is only
      // for the platform admin's cross-tenant dashboard / org switcher.
      allow list: if isPlatformAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isTenantAdmin(orgId)
        && (
          !("ownerUid" in resource.data)
          || request.resource.data.ownerUid == resource.data.ownerUid
        );
      allow delete: if false;
    }

    match /organizations/{orgId}/users/{userId} {
      // Only the org owner may bootstrap their own admin access;
      // everyone else must be provisioned by an existing admin.
      allow create: if signedIn()
        && request.resource.data.organizationId == orgId
        && (
          (request.auth.uid == userId && isOrgOwner(orgId))
          || isTenantAdmin(orgId)
        );

      allow read: if signedIn() && (request.auth.uid == userId || isTenantAdmin(orgId));

      // Users may edit their own profile but never their roles,
      // active flag or tenant binding.
      allow update: if isTenantAdmin(orgId)
        || (
          signedIn()
          && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(["roles", "isActive", "organizationId"])
        );

      allow delete: if isTenantAdmin(orgId);
    }

    match /organizations/{orgId}/settings/{documentId} {
      allow read: if isTenantMember(orgId) || isPlatformAdmin();
      allow write: if isTenantAdmin(orgId);
    }

    // AI usage counters (organizations/{orgId}/aiUsage/{yyyy-mm}): qualquer
    // membro ativo pode incrementar (é ele quem consome a cota ao usar as
    // ferramentas de IA, ex: líder de célula no app); platform admin lê
    // entre todas as orgs pro painel cross-tenant.
    match /organizations/{orgId}/aiUsage/{documentId} {
      allow read: if isTenantMember(orgId) || isPlatformAdmin();
      allow write: if isTenantMember(orgId);
    }

    // Financial records: a member can only read their own contributions.
    // Admin lança contribuição já confirmada manualmente a qualquer momento.
    // Membro comum só pode criar a PRÓPRIA contribuição, e só como "pending"
    // (autodeclarada via PIX real pelo app) — igreja confirma depois de
    // conferir o comprovante/extrato, mesmo espírito de moderação usado em
    // prayerRequests abaixo. Depois de criada, só admin edita/confirma.
    match /organizations/{orgId}/contributions/{contributionId} {
      allow read: if isTenantAdmin(orgId)
        || (isTenantMember(orgId) && resource.data.userId == request.auth.uid);

      allow create: if isTenantAdmin(orgId)
        || (
          isTenantMember(orgId)
          && request.resource.data.organizationId == orgId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.registeredBy == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
        );

      allow update, delete: if isTenantAdmin(orgId);
    }

    // Promoções do marketplace (nível flat da org): membro lê (feed/notificação
    // in-app no app), só admin publica/edita.
    match /organizations/{orgId}/marketplacePromotions/{promotionId} {
      allow read: if isTenantMember(orgId);
      allow write: if isTenantAdmin(orgId);
    }

    // Comunicação (histórico de envios + templates): só liderança (admin) —
    // conteúdo de comunicados é sensível. Excluído dos catch-alls de leitura.
    match /organizations/{orgId}/communicationLog/{entryId} {
      allow read, write: if isTenantAdmin(orgId);
    }
    match /organizations/{orgId}/communicationTemplates/{templateId} {
      allow read, write: if isTenantAdmin(orgId);
    }

    // Comprovantes de contribuição (imagem base64). O membro cria o próprio ao
    // autodeclarar o PIX; só admin lê (dado financeiro) — por isso também está
    // excluído dos catch-alls de leitura abaixo.
    match /organizations/{orgId}/contributionReceipts/{receiptId} {
      allow read: if isTenantAdmin(orgId);
      allow create: if isTenantMember(orgId)
        && request.resource.data.organizationId == orgId
        && request.resource.data.createdByUserId == request.auth.uid;
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Mídia — histórico de banners gerados (thumbnail + inputs para reabrir).
    // Material de divulgação, não sensível. O catch-all abaixo já deixa membro
    // ler e admin escrever; este bloco (via OR) libera create/update para
    // QUALQUER membro — a equipe de mídia que gera banner nem sempre é admin.
    // Apagar continua restrito a admin.
    match /organizations/{orgId}/bannerHistory/{bannerId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantMember(orgId)
        && request.resource.data.organizationId == orgId;
      allow update: if isTenantMember(orgId);
      allow delete: if isTenantAdmin(orgId);
    }

    // Public visitor form: unauthenticated create with strict shape and
    // size validation. Reads/updates stay restricted to the tenant team.
    match /organizations/{orgId}/visitorIntakes/{intakeId} {
      allow create: if request.resource.data.source == "public_form"
        && request.resource.data.status == "captured"
        && request.resource.data.organizationId == orgId
        && request.resource.data.keys().hasOnly([
          "organizationId", "name", "phone", "email", "birthDate",
          "neighborhood", "firstVisit", "howHeard", "consentMarketing",
          "source", "status", "orgSlug", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 14
        && request.resource.data.firstVisit is bool
        && request.resource.data.consentMarketing is bool
        && (request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 160))
        && (request.resource.data.birthDate == null || (request.resource.data.birthDate is string && request.resource.data.birthDate.size() <= 10))
        && (request.resource.data.neighborhood == null || (request.resource.data.neighborhood is string && request.resource.data.neighborhood.size() <= 120))
        && (request.resource.data.howHeard == null || (request.resource.data.howHeard is string && request.resource.data.howHeard.size() <= 200));
      allow read: if isTenantMember(orgId);
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Campanhas de oferta (metas de arrecadação): gestão só do time (admin);
    // membro lista; UMA campanha pode ser lida publicamente (get) pra o link
    // público /p/{slug}/give?campanha={id} mostrar título/meta/progresso.
    match /organizations/{orgId}/givingCampaigns/{campaignId} {
      allow get: if true;
      allow list: if isTenantMember(orgId);
      allow write: if isTenantAdmin(orgId);
    }

    // Comprovante de doação pública ("Já paguei" no link): create não autenticado
    // com shape estrito (imagem base64 até ~1MB). Só admin lê.
    match /organizations/{orgId}/givingReceipts/{receiptId} {
      allow read: if isTenantAdmin(orgId);
      allow create: if request.resource.data.organizationId == orgId
        && request.resource.data.keys().hasOnly(["organizationId", "intentId", "imageBase64", "createdAt"])
        && request.resource.data.intentId is string
        && (!("imageBase64" in request.resource.data) || request.resource.data.imageBase64.size() < 1500000);
    }

    // Doação pública sem-app (/p/{slug}/give): create não autenticado com shape
    // estrito. NÃO envolve dinheiro (só o lead/intenção) — o PIX é da própria
    // igreja. Leitura/gestão só do time do tenant.
    match /organizations/{orgId}/givingIntents/{intentId} {
      allow create: if request.resource.data.source == "public_give"
        && request.resource.data.status == "captured"
        && request.resource.data.organizationId == orgId
        && request.resource.data.keys().hasOnly([
          "organizationId", "name", "whatsapp", "amount",
          "source", "status", "orgSlug", "campaignId", "consentContact", "createdAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.size() >= 8
        && request.resource.data.whatsapp.size() <= 20
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.consentContact is bool
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        && (request.resource.data.orgSlug == null || (request.resource.data.orgSlug is string && request.resource.data.orgSlug.size() <= 120));
      allow read: if isTenantMember(orgId);
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Ledger financeiro (lançamentos de entrada/saída/missões): dado sensível —
    // só a liderança administrativa lê e escreve.
    match /organizations/{orgId}/financialTransactions/{transactionId} {
      allow read, write: if isTenantAdmin(orgId);
    }

    // Prayer requests: any signed-in tenant member can submit one (from the
    // app or reception). Pastoral staff can read/triage/resolve all of them;
    // regular members can only read ones the author opted to make public
    // (the community prayer wall), and may only bump the prayer counter.
    match /organizations/{orgId}/prayerRequests/{requestId} {
      allow create: if isTenantMember(orgId)
        && request.resource.data.organizationId == orgId
        && request.resource.data.status == "open"
        && request.resource.data.isPublic is bool
        && request.resource.data.prayerCount == 0
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.personName is string
        && request.resource.data.personName.size() <= 160;

      allow read: if isTenantAdmin(orgId)
        || (isTenantMember(orgId) && resource.data.isPublic == true);

      allow update: if isTenantAdmin(orgId)
        || (
          isTenantMember(orgId)
          && resource.data.isPublic == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["prayerCount"])
          && request.resource.data.prayerCount == resource.data.prayerCount + 1
        );

      allow delete: if isTenantAdmin(orgId);
    }

    // Cadastro de pessoas: limitado pelo plano da organização (Gratuito 50,
    // Comunidade 300, Pastoral/Rede sem limite). O contador memberCount em
    // organizations/{orgId} é mantido pela própria app (savePersonProfile).
    match /organizations/{orgId}/people/{personId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantAdmin(orgId) && withinMemberLimit(orgId);
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Histórico de tribo do membro: auditoria de classificações (IA) e ajustes
    // manuais. Membro do tenant lê; só admin grava (registro é imutável — sem
    // update/delete pelo cliente).
    match /organizations/{orgId}/people/{personId}/tribeHistory/{entryId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantAdmin(orgId);
      allow update, delete: if false;
    }

    // Progresso do aluno na Escola EAD (people/{uid}/courseProgress). O membro
    // grava o PRÓPRIO progresso (personId == uid); admin também pode. Como as
    // regras são OR, este match libera a escrita mesmo com o catch-all negando
    // subcoleções de "people".
    match /organizations/{orgId}/people/{personId}/courseProgress/{progressId} {
      allow read: if isTenantMember(orgId);
      allow write: if isTenantMember(orgId) && (personId == request.auth.uid || isTenantAdmin(orgId));
    }

    // Igrejas filiais (plano Rede): até 50 filiais, só quem está no plano
    // Rede ou Enterprise pode ter alguma. O contador affiliateCount em
    // organizations/{orgId} é mantido por saveNetworkAffiliate.
    match /organizations/{orgId}/affiliates/{affiliateId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantAdmin(orgId) && withinBranchOrgLimit(orgId);
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Entitlements de trilhas compradas na Loja de Capacitação. Membros leem
    // (para saber o que a igreja já comprou); NINGUÉM escreve pelo cliente —
    // só o webhook de pagamento (service account, que ignora as rules). Sem
    // isso, um admin poderia se auto-conceder acesso gratuito.
    match /organizations/{orgId}/programEntitlements/{programId} {
      allow read: if isTenantMember(orgId);
      allow write: if false;
    }

    // Segurança Kids: check-in/out de crianças (dado sensível de menor).
    // Leitura por membro do tenant (o responsável precisa ver o check-in
    // ativo do filho p/ exibir o QR de retirada); escrita só por quem pode
    // operar a sala (admin + papéis configurados em settings/kids).
    match /organizations/{orgId}/kidsCheckIns/{checkInId} {
      allow read: if isTenantMember(orgId);
      allow write: if canOperateKids(orgId);
    }

    // Inscrição em evento: o membro cria a PRÓPRIA inscrição (responsiblePersonId
    // = seu uid). Leitura por membro (ver o próprio ingresso / admin ver todos);
    // alterar/excluir/marcar presença só admin. Regra específica é OR com o
    // catch-all abaixo (que só deixa admin escrever) — libera o self-register.
    match /organizations/{orgId}/events/{eventId}/registrations/{regId} {
      allow read: if isTenantMember(orgId);
      allow create: if isTenantMember(orgId)
        && request.resource.data.responsiblePersonId == request.auth.uid;
      allow update, delete: if isTenantAdmin(orgId);
    }

    // Generic tenant collections (one level deep), excluding the
    // privacy-sensitive collections handled above.
    match /organizations/{orgId}/{collection}/{documentId} {
      allow read: if isTenantMember(orgId)
        && collection != "contributions"
        && collection != "contributionReceipts"
        && collection != "financialTransactions"
        && collection != "communicationLog"
        && collection != "communicationTemplates"
        && collection != "users"
        && collection != "prayerRequests";
      allow write: if isTenantAdmin(orgId)
        && collection != "users"
        && collection != "prayerRequests"
        && collection != "people"
        && collection != "affiliates"
        && collection != "programEntitlements";
    }

    // Nested subcollections (groups/{id}/members, events/{id}/tickets, ...).
    // {document=**} também casa com ZERO segmentos extras — ou seja, esse
    // bloco reabre (via OR) qualquer coleção de 2 segmentos que outro match
    // acima tenha restringido, com nenhuma das condições extras deles. Por
    // isso as mesmas exclusões de nome de coleção valem aqui também — foi
    // exatamente esse bug que deixava passar cadastro de membro acima do
    // limite do plano (people não tinha "&& document.size() > 0" nem
    // exclusão, e essa regra tinha "allow write: if isTenantAdmin(orgId)"
    // sem checar limite nenhum).
    match /organizations/{orgId}/{collection}/{documentId}/{document=**} {
      allow read: if isTenantMember(orgId)
        && collection != "contributions"
        && collection != "contributionReceipts"
        && collection != "financialTransactions"
        && collection != "communicationLog"
        && collection != "communicationTemplates"
        && collection != "users"
        && collection != "prayerRequests";
      allow write: if isTenantAdmin(orgId)
        && collection != "users"
        && collection != "prayerRequests"
        && collection != "people"
        && collection != "affiliates"
        && collection != "programEntitlements";
    }
  }
}
