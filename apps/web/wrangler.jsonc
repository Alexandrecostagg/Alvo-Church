{
  "name": "alvo-church-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-05-01",
  "routes": [
    { "pattern": "plataformaesdras.com.br/*", "zone_name": "plataformaesdras.com.br" },
    { "pattern": "www.plataformaesdras.com.br/*", "zone_name": "plataformaesdras.com.br" }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets"
  },
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "60605570c4774907b4f4d5b6395dd4c4"
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "NEXT_PUBLIC_FIREBASE_API_KEY": "AIzaSyBe9StFXtahsJb_AMSMNLrvdOImi9YRBu4",
    "NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN": "alvo-church.firebaseapp.com",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "alvo-church",
    "NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET": "alvo-church.firebasestorage.app",
    "NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID": "616327426236",
    "NEXT_PUBLIC_FIREBASE_APP_ID": "1:616327426236:web:8b3e265426a5d00ce120b9",
    "NEXT_PUBLIC_USE_FIREBASE_EMULATOR": "false",
    "NEXT_PRIVATE_MINIMAL_MODE": "1",
    // Valores de PRODUÇÃO — o deploy sobrescreve o que estiver no dashboard
    // da Cloudflare, então estas vars precisam viver aqui no arquivo.
    "ASAAS_API_BASE_URL": "https://api.asaas.com/v3",
    "WORKER_API_BASE_URL": "https://alvo-church-worker-api.alexandrecostagg.workers.dev"
  }
}
