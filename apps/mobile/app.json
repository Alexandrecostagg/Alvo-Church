{
  "expo": {
    "name": "EsdrasApp",
    "slug": "plataforma-esdras",
    "scheme": "plataformaesdras",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "backgroundColor": "#123f34",
    "primaryColor": "#dc7938",
    "icon": "./assets/generated/esdras-app-icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "icon": "./assets/generated/esdras-app-icon.png",
      "bundleIdentifier": "com.plataformaesdras.app",
      "appleTeamId": "LCN99JS59U"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/generated/esdras-adaptive-foreground.png",
        "backgroundColor": "#123f34"
      },
      "package": "com.plataformaesdras.app",
      "versionCode": 6,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "O app usa a câmera para escanear o QR de retirada da Segurança Kids."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app usa a câmera para registrar a foto de segurança da criança no check-in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/generated/esdras-notification-icon.png",
          "color": "#123f34",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/generated/esdras-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#123f34"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d18300c4-7863-48e4-8772-9af9039099a2"
      }
    },
    "owner": "alexandrecostagg"
  }
}
