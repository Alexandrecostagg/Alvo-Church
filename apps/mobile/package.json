{
  "name": "@alvo/mobile",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "node ../../scripts/with-workspace-env.mjs expo start",
    "build": "node ../../scripts/with-workspace-env.mjs expo export --platform all",
    "eas:preview": "node ../../scripts/with-workspace-env.mjs npx eas-cli@latest build --profile preview --platform all",
    "eas:store-test": "node ../../scripts/with-workspace-env.mjs npx eas-cli@latest build --profile store-test --platform all",
    "lint": "tsc --project tsconfig.json --noEmit",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@alvo/domain": "workspace:*",
    "@alvo/firebase": "workspace:*",
    "@alvo/types": "workspace:*",
    "@alvo/ui": "workspace:*",
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~57.0.20",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-font": "~57.0.3",
    "expo-image-picker": "~57.0.16",
    "expo-notifications": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "prettier": "^3.5.3",
    "typescript": "^6.0.3"
  }
}
