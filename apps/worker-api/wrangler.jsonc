{
  "name": "alvo-church-worker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-17",
  "vars": {
    "PUBLIC_BRAND_BASE_URL": "https://assets.alvochurch.app",
    "FIREBASE_PROJECT_ID": "alvo-church"
  },
  // Um único cron processa WhatsApp por minuto e NetworkSnapshot às 06:00 UTC.
  // Requer o secret GOOGLE_SERVICE_ACCOUNT_JSON (wrangler secret put).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": { "bindings": [{ "name": "WIFI_RATE_LIMIT", "class_name": "WifiRateLimit" }] },
  "migrations": [{ "tag": "security-wifi-v1", "new_sqlite_classes": ["WifiRateLimit"] }],
  "r2_buckets": [
    {
      "binding": "BRAND_ASSETS_BUCKET",
      "bucket_name": "alvo-brand-assets"
    }
  ]
}
