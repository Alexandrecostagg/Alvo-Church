{
  "name": "alvo-church",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "build": "corepack pnpm -r build",
    "build:cloudflare:web": "corepack pnpm --filter @alvo/web build:cloudflare",
    "dev": "corepack pnpm --parallel --filter @alvo/web --filter @alvo/mobile --filter @alvo/worker-api dev",
    "lint": "corepack pnpm -r lint",
    "typecheck": "corepack pnpm -r typecheck",
    "format": "corepack pnpm -r format",
    "seed:firebase": "tsx scripts/seed-firebase.ts",
    "seed:capacitacao": "tsx scripts/seed-capacitacao.ts",
    "seed:catalogo-final": "tsx scripts/seed-catalogo-final.ts",
    "dev:emulator": "firebase emulators:start",
    "db:seed:local": "cross-env FIRESTORE_EMULATOR_HOST=localhost:8080 FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 FIREBASE_PROJECT_ID=alvo-church tsx scripts/seed-firebase.ts"
  },
  "devDependencies": {
